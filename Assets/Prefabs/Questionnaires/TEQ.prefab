  m_Name: 
  m_EditorClassIdentifier: 
  questionnaireName: TEQ_Questions
  questions:
  - questionText: I felt like I was tapping my left hand.
    positiveText: Strongly agree
    negativeText: Strongly disagree
  - questionText: The touch on my left hand matched the movements I made with my
      right hand.
    positiveText: Strongly agree
    negativeText: Strongly disagree
  - questionText: I felt as if the virtual body was my body.
    positiveText: Strongly agree
    negativeText: Strongly disagree
  - questionText: I felt like my left hand was becoming bigger.
    positiveText: Strongly agree
    negativeText: Strongly disagree
  - questionText: "I couldn\u2019t feel my left hand ."
    positiveText: Strongly agree
    negativeText: Strongly disagree
  - questionText: How confident do you feel about your answers?
    positiveText: Very confident
    negativeText: Not confident at all
